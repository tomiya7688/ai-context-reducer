{
  "schema_version": 1,
  "bundle_kind": "full",
  "target_release_version": "1.1.0",
  "artifact_status": "target_contract",
  "source_of_truth": "release/FULL_BUNDLE_MANIFEST.json",
  "compatibility": {
    "normal_bundle_manifest": "release/RELEASE_MANIFEST.json",
    "normal_bundle_is_preserved": true,
    "full_bundle_is_superset_of_normal_root": true,
    "cli_contract": "tools/JSON_CONTRACT.md",
    "cli_paths_unchanged_in_full_bundle": true
  },
  "platforms": [
    "windows-x64",
    "windows-arm64",
    "linux-x64",
    "linux-arm64",
    "macos-x64",
    "macos-arm64"
  ],
  "platform_rules": {
    "windows_executable_suffix": ".exe",
    "other_executable_suffix": "",
    "go_binaries_are_prebuilt_per_platform": true,
    "go_source_is_distributed": false,
    "go_toolchain_required": false
  },
  "execution_policy": {
    "install_missing_runtime_or_sdk": false,
    "install_missing_external_tool": false,
    "auto_run_large_or_heavy_analysis": false,
    "auto_run_all_bundled_tools": false,
    "gui_uses_existing_cli_json_contract": true,
    "python_runtime_required_for_core_cli_or_gui": false
  },
  "layout": {
    "normal_bundle_core": "/",
    "gui": "gui/",
    "python_fallback": "fallback/python/",
    "profiles": "profiles/",
    "templates": "templates/",
    "japanese_docs": "docs/jp/",
    "english_docs": "docs/en/"
  },
  "root_files": [
    {
      "bundle_path": "acr-toolbox{exe}",
      "kind": "prebuilt_go_binary",
      "source_module": "tools/common/native/acr-toolbox",
      "normal_bundle_compatible": true,
      "include_source": false
    },
    {
      "bundle_path": "go-symbols{exe}",
      "kind": "prebuilt_go_binary",
      "source_module": "tools/go/small/go-symbols",
      "normal_bundle_compatible": true,
      "include_source": false
    },
    {
      "bundle_path": "go-import-map{exe}",
      "kind": "prebuilt_go_binary",
      "source_module": "tools/go/medium/go-import-map",
      "normal_bundle_compatible": true,
      "include_source": false
    },
    {
      "bundle_path": "go-package-graph{exe}",
      "kind": "prebuilt_go_binary",
      "source_module": "tools/go/large/go-package-graph",
      "normal_bundle_compatible": true,
      "include_source": false
    },
    {
      "bundle_path": "affected-tests{exe}",
      "kind": "prebuilt_go_binary",
      "source_module": "tools/go/medium/affected-tests",
      "normal_bundle_compatible": true,
      "include_source": false
    },
    {
      "bundle_path": "README.md",
      "kind": "document",
      "source": "README.md",
      "normal_bundle_compatible": true
    },
    {
      "bundle_path": "TOOLS_README.md",
      "kind": "document",
      "source": "tools/README.md",
      "normal_bundle_compatible": true
    },
    {
      "bundle_path": "LICENSE",
      "kind": "license",
      "source": "LICENSE",
      "normal_bundle_compatible": true
    },
    {
      "bundle_path": "RELEASE_MANIFEST.json",
      "kind": "normal_bundle_manifest",
      "source": "release/RELEASE_MANIFEST.json",
      "normal_bundle_compatible": true
    },
    {
      "bundle_path": "FULL_BUNDLE_MANIFEST.json",
      "kind": "full_bundle_manifest",
      "source": "release/FULL_BUNDLE_MANIFEST.json",
      "normal_bundle_compatible": false
    }
  ],
  "gui_files": [
    {
      "bundle_path": "gui/acr-hub{exe}",
      "kind": "prebuilt_gui_entrypoint",
      "required_for_release": true,
      "implementation_issue": 25,
      "screen_issue": 26,
      "project_analysis_issue": 27,
      "additional_runtime_required": false
